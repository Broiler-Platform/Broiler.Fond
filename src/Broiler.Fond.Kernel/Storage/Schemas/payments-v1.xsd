<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:f="urn:broiler:fond:profile:1" targetNamespace="urn:broiler:fond:profile:1" elementFormDefault="qualified">
  <xs:simpleType name="uuid">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positiveId">
    <xs:restriction base="xs:unsignedLong">
      <xs:minInclusive value="1" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="payments">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="draft" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="currentRevisionId" type="f:positiveId" />
              <xs:element name="createdAt" type="xs:string" />
              <xs:element name="updatedAt" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="sourceAccountId" type="f:positiveId" use="required" />
            <xs:attribute name="sourceAccountBindingId" type="f:positiveId" use="required" />
            <xs:attribute name="sourceAccountIncarnationId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="revision" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="revisionNumber" type="xs:int" />
              <xs:element name="timestamp" type="xs:string" />
              <xs:element name="sourceAccountId" type="f:positiveId" />
              <xs:element name="sourceAccountBindingId" type="f:positiveId" />
              <xs:element name="sourceAccountIncarnationId" type="f:positiveId" />
              <xs:element name="beneficiary">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="name" type="xs:string" />
                    <xs:element name="iban" type="xs:string" />
                    <xs:element name="bic" type="xs:string" minOccurs="0" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="amount" type="xs:string" />
              <xs:element name="currency" type="xs:string" />
              <xs:element name="remittance" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="unstructured" type="xs:string" minOccurs="0" />
                    <xs:element name="creditorReference" type="xs:string" minOccurs="0" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="executionMode" type="xs:string" />
              <xs:element name="executionDate" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="draftId" type="f:positiveId" use="required" />
            <xs:attribute name="predecessorRevisionId" type="f:positiveId" use="optional" />
          </xs:complexType>
        </xs:element>
        <xs:element name="attempt" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sourceAccountId" type="f:positiveId" />
              <xs:element name="sourceAccountBindingId" type="f:positiveId" />
              <xs:element name="sourceAccountIncarnationId" type="f:positiveId" />
              <xs:element name="endToEndId" type="xs:string" />
              <xs:element name="state" type="xs:string" />
              <xs:element name="vopResult" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="status" type="xs:string" />
                    <xs:element name="checkedAt" type="xs:string" />
                    <xs:element name="matchedName" type="xs:string" minOccurs="0" />
                    <xs:element name="reasonCode" type="xs:string" minOccurs="0" />
                    <xs:element name="warningMessage" type="xs:string" minOccurs="0" />
                    <xs:element name="userOverride" type="xs:boolean" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="bankReference" type="xs:string" minOccurs="0" />
              <xs:element name="responseCode" type="xs:string" minOccurs="0" />
              <xs:element name="statusDescription" type="xs:string" minOccurs="0" />
              <xs:element name="createdAt" type="xs:string" />
              <xs:element name="updatedAt" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="draftId" type="f:positiveId" use="required" />
            <xs:attribute name="draftRevisionId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="transition" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="fromState" type="xs:string" />
              <xs:element name="toState" type="xs:string" />
              <xs:element name="timestamp" type="xs:string" />
              <xs:element name="reason" type="xs:string" />
              <xs:element name="bankCode" type="xs:string" minOccurs="0" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="attemptId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="generation" type="f:positiveId" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
