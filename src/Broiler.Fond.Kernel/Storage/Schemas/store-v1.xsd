<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:f="urn:broiler:fond:profile:1" targetNamespace="urn:broiler:fond:profile:1" elementFormDefault="qualified">
  <xs:simpleType name="uuid">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positiveId">
    <xs:restriction base="xs:unsignedLong">
      <xs:minInclusive value="1" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="digest">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{64}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="profile">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="label" type="xs:string" />
        <xs:element name="note" type="xs:string" />
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="parentBranchId" type="f:uuid" use="optional" />
      <xs:attribute name="recoveryProvenance" type="xs:string" use="optional" />
      <xs:attribute name="generation" type="f:positiveId" use="required" />
      <xs:attribute name="nextId" type="f:positiveId" use="required" />
      <xs:attribute name="savedAt" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="institutions">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="institution" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="displayName" type="xs:string" />
              <xs:element name="endpoint" type="xs:string" />
              <xs:element name="bankCode" type="xs:string" minOccurs="0" />
              <xs:element name="bic" type="xs:string" minOccurs="0" />
              <xs:element name="verificationState" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="generation" type="f:positiveId" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="connections">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="connection" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="userId" type="xs:string" />
              <xs:element name="customerId" type="xs:string" minOccurs="0" />
              <xs:element name="state" type="xs:string" />
              <xs:element name="systemId" type="xs:string" minOccurs="0" />
              <xs:element name="systemStatus" type="xs:string" />
              <xs:element name="nextClientMessageNumber" type="xs:int" />
              <xs:element name="isSynchronized" type="xs:boolean" />
              <xs:element name="lastSuccessfulContact" type="xs:string" minOccurs="0" />
              <xs:element name="lastAttemptedContact" type="xs:string" minOccurs="0" />
              <xs:element name="connectorVersion" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="institutionId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="generation" type="f:positiveId" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="accounts">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="account" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="displayName" type="xs:string" />
              <xs:element name="currency" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="incarnation" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="lifetimeEvidence" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="accountId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="binding" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="state" type="xs:string" />
              <xs:element name="locator">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="iban" type="xs:string" minOccurs="0" />
                    <xs:element name="domesticAccountNumber" type="xs:string" minOccurs="0" />
                    <xs:element name="domesticBankCode" type="xs:string" minOccurs="0" />
                    <xs:element name="subaccount" type="xs:string" minOccurs="0" />
                    <xs:element name="currency" type="xs:string" minOccurs="0" />
                    <xs:element name="bankIdentifier" minOccurs="0" maxOccurs="32">
                      <xs:complexType>
                        <xs:attribute name="issuer" type="xs:string" use="required" />
                        <xs:attribute name="scope" type="xs:string" use="required" />
                        <xs:attribute name="kind" type="xs:string" use="required" />
                        <xs:attribute name="value" type="xs:string" use="required" />
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="connector" type="xs:string" use="required" />
                  <xs:attribute name="connectorVersion" type="xs:string" use="required" />
                  <xs:attribute name="endpoint" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="accountId" type="f:positiveId" use="required" />
            <xs:attribute name="incarnationId" type="f:positiveId" use="required" />
            <xs:attribute name="institutionId" type="f:positiveId" use="required" />
            <xs:attribute name="connectionId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="capability" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="advertisedLimit" type="xs:string" minOccurs="0" />
            </xs:sequence>
            <xs:attribute name="connectionId" type="f:positiveId" use="required" />
            <xs:attribute name="accountId" type="f:positiveId" use="required" />
            <xs:attribute name="operationCode" type="xs:string" use="required" />
            <xs:attribute name="operationVersion" type="xs:int" use="required" />
            <xs:attribute name="status" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="generation" type="f:positiveId" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="balances">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="balance" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="kind" type="xs:string" />
              <xs:element name="amount" type="xs:string" minOccurs="0" />
              <xs:element name="currency" type="xs:string" minOccurs="0" />
              <xs:element name="bankTimestamp" type="xs:string" minOccurs="0" />
              <xs:element name="retrievedAt" type="xs:string" />
              <xs:element name="isStale" type="xs:boolean" />
              <xs:element name="sourceLabel" type="xs:string" minOccurs="0" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="observationId" type="f:positiveId" use="required" />
            <xs:attribute name="accountId" type="f:positiveId" use="required" />
            <xs:attribute name="incarnationId" type="f:positiveId" use="required" />
            <xs:attribute name="bindingId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="generation" type="f:positiveId" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="ledger">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="record" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="supersedes" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="id" type="f:positiveId" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="reference" minOccurs="0" maxOccurs="64">
                <xs:complexType>
                  <xs:attribute name="targetId" type="f:positiveId" use="required" />
                  <xs:attribute name="expectedKind" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="kind" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="generation" type="f:positiveId" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="manifest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="entry" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required" />
            <xs:attribute name="schema" type="xs:string" use="required" fixed="1" />
            <xs:attribute name="bytes" type="f:positiveId" use="required" />
            <xs:attribute name="sha256" type="f:digest" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="generation" type="f:positiveId" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
