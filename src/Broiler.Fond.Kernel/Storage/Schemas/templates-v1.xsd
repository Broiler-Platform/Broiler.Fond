<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:f="urn:broiler:fond:profile:1" targetNamespace="urn:broiler:fond:profile:1" elementFormDefault="qualified">
  <xs:simpleType name="uuid">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positiveId">
    <xs:restriction base="xs:unsignedLong">
      <xs:minInclusive value="1" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="templates">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="template" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="label" type="xs:string" />
              <xs:element name="beneficiary">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="name" type="xs:string" />
                    <xs:element name="iban" type="xs:string" />
                    <xs:element name="bic" type="xs:string" minOccurs="0" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="defaultRemittance" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="unstructured" type="xs:string" minOccurs="0" />
                    <xs:element name="creditorReference" type="xs:string" minOccurs="0" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="defaultAmount" type="xs:string" minOccurs="0" />
              <xs:element name="defaultCurrency" type="xs:string" minOccurs="0" />
              <xs:element name="defaultExecutionMode" type="xs:string" minOccurs="0" />
              <xs:element name="createdAt" type="xs:string" />
              <xs:element name="updatedAt" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="isSoftDeleted" type="xs:boolean" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="generation" type="xs:unsignedLong" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
