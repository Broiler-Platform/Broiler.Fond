<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:f="urn:broiler:fond:profile:1" targetNamespace="urn:broiler:fond:profile:1" elementFormDefault="qualified">
  <xs:simpleType name="uuid">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positiveId">
    <xs:restriction base="xs:unsignedLong">
      <xs:minInclusive value="1" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="transactions">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="observation" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="statementFormat" type="xs:string" />
              <xs:element name="statementNumber" type="xs:string" minOccurs="0" />
              <xs:element name="pageToken" type="xs:string" minOccurs="0" />
              <xs:element name="retrievedAt" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="accountBindingId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="transaction" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="status" type="xs:string" />
              <xs:element name="kind" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="accountId" type="f:positiveId" use="required" />
            <xs:attribute name="accountIncarnationId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="revision" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="status" type="xs:string" />
              <xs:element name="kind" type="xs:string" />
              <xs:element name="amount" type="xs:string" />
              <xs:element name="currency" type="xs:string" />
              <xs:element name="isCredit" type="xs:boolean" />
              <xs:element name="bookingDate" type="xs:string" />
              <xs:element name="valueDate" type="xs:string" minOccurs="0" />
              <xs:element name="bankTimestamp" type="xs:string" minOccurs="0" />
              <xs:element name="retrievedAt" type="xs:string" />
              <xs:element name="counterparty" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="name" type="xs:string" minOccurs="0" />
                    <xs:element name="iban" type="xs:string" minOccurs="0" />
                    <xs:element name="bic" type="xs:string" minOccurs="0" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="remittance" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="unstructuredText" type="xs:string" minOccurs="0" />
                    <xs:element name="endToEndId" type="xs:string" minOccurs="0" />
                    <xs:element name="mandateId" type="xs:string" minOccurs="0" />
                    <xs:element name="creditorId" type="xs:string" minOccurs="0" />
                    <xs:element name="customerReference" type="xs:string" minOccurs="0" />
                    <xs:element name="bankReference" type="xs:string" minOccurs="0" />
                    <xs:element name="purposeCode" type="xs:string" minOccurs="0" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="returnReasonCode" type="xs:string" minOccurs="0" />
              <xs:element name="rawBankCode" type="xs:string" minOccurs="0" />
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="transactionId" type="f:positiveId" use="required" />
            <xs:attribute name="observationId" type="f:positiveId" use="required" />
            <xs:attribute name="accountId" type="f:positiveId" use="required" />
            <xs:attribute name="accountIncarnationId" type="f:positiveId" use="required" />
            <xs:attribute name="accountBindingId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="annotation" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="revisionTimestamp" type="xs:string" />
              <xs:element name="userNote" type="xs:string" minOccurs="0" />
              <xs:element name="category" type="xs:string" minOccurs="0" />
              <xs:element name="tag" type="xs:string" minOccurs="0" maxOccurs="64" />
              <xs:element name="split" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="amount" type="xs:string" />
                    <xs:element name="category" type="xs:string" />
                    <xs:element name="note" type="xs:string" minOccurs="0" />
                    <xs:element name="tag" type="xs:string" minOccurs="0" maxOccurs="32" />
                  </xs:sequence>
                  <xs:attribute name="index" type="xs:int" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="id" type="f:positiveId" use="required" />
            <xs:attribute name="transactionId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="link" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="linkedAt" type="xs:string" />
              <xs:element name="matchCriterion" type="xs:string" />
            </xs:sequence>
            <xs:attribute name="pendingTransactionId" type="f:positiveId" use="required" />
            <xs:attribute name="bookedTransactionId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="checkpoint" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="windowStart" type="xs:string" />
              <xs:element name="windowEnd" type="xs:string" />
              <xs:element name="lastSyncTimestamp" type="xs:string" />
              <xs:element name="lastContinuationToken" type="xs:string" minOccurs="0" />
              <xs:element name="isComplete" type="xs:boolean" />
              <xs:element name="observedTransactionCount" type="xs:int" />
            </xs:sequence>
            <xs:attribute name="accountId" type="f:positiveId" use="required" />
            <xs:attribute name="accountIncarnationId" type="f:positiveId" use="required" />
            <xs:attribute name="accountBindingId" type="f:positiveId" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1" />
      <xs:attribute name="profileId" type="f:uuid" use="required" />
      <xs:attribute name="branchId" type="f:uuid" use="required" />
      <xs:attribute name="generation" type="f:positiveId" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
